# Docker Compose: use a long random URL-safe password (letters/numbers/-/_).
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
WEB_PORT=8080
# Only needed for noninteractive `docker compose run --rm init`.
# Omit this to use the CLI's interactive prompt; do not commit real passwords.
# ADMIN_PASSWORD=

# Registered-user auth: independent random secret, minimum 32 bytes.
USER_JWT_SECRET=
USER_REFRESH_TOKEN_DAYS=7
# Production deployments must use real SMS verification.
USER_SMS_MOCK_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
