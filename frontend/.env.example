# Copy to .env.local. Restart Vite after changing environment variables.
VITE_APP_TITLE=FastVue-Admin
VITE_STORAGE_PREFIX=fastvue
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api
# starter: system + developer examples; full: include legacy business examples
VITE_APP_PRESET=starter
VITE_ENABLE_ORGANIZATION=false
