# Create this database/user first; encode special characters in URL credentials.
DATABASE_URL=postgresql+asyncpg://fastvue:change-me@127.0.0.1:5432/fastvue
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:63342","http://127.0.0.1:63342"]
SESSION_HOURS=8
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=900
# ADMIN_PASSWORD is consumed by the explicit init CLI, not the API server.
# Prefer its interactive password prompt for local use.

# Independent registered-user authentication; administrator sessions are unchanged.
ENVIRONMENT=development
REDIS_URL=redis://127.0.0.1:6379/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
USER_JWT_SECRET=
USER_JWT_ISSUER=ws-fastvue-user
USER_REFRESH_TOKEN_DAYS=7
USER_AUTH_REDIS_PREFIX=fastvue:user:auth
# Local development only: explicitly enable to bypass real SMS verification.
USER_SMS_MOCK_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
